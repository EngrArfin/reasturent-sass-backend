// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  business_admin
  supervisor
  manager
  cashier
  server
  kitchen
}

model Business {
  id              String    @id @default(uuid())
  name            String    @unique
  businessName    String
  email           String
  phone           String?
  address         String?
  industry        String    @default("RESTAURANT")
  subscriptionFee String            @default("CFA 99/mo")
  lastSync        DateTime?         @default(now())
  allowedRoles    Json?             @default("[\"manager\", \"supervisor\", \"server\", \"kitchen\", \"cashier\"]")
  isActive        Boolean           @default(true)
  settings        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)

  users     User[]
  vouchers  Voucher[]
  tickets   Ticket[]
  products  Product[]
  tables    RestaurantTable[]
  menuItems MenuItem[]
  orders    Order[]
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  role       UserRole  @default(manager)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  pin        String?
  avatar     String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Voucher {
  id           String    @id @default(uuid())
  name         String    @default("Special Voucher")
  code         String?   @unique
  minimumPrice Float     @default(0.0)
  offPrice     String    @default("10%")
  amountOff    Float     @default(0.0)
  finalPrice   Float     @default(0.0)
  requestedBy  String?   @default("Manager")
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  isUsed       Boolean   @default(false)
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId])
}

model Ticket {
  id              String          @id @default(uuid())
  title           String          @default("Support Ticket")
  category        String          @default("Sync Issue")
  description     String?
  status          String          @default("OPEN")
  priority        String          @default("MEDIUM")
  deviceId        String?         @default("RENE-POS-8821")
  softwareVersion String?         @default("v2.4.1-stable")
  lastSync        DateTime?       @default(now())
  businessId      String?
  business        Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdById     String?
  messages        TicketMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([businessId])
  @@index([status])
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String?
  senderName String   @default("User")
  senderRole String   @default("manager")
  message    String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model SubscriptionPlan {
  id          String     @id @default(uuid())
  name        String     @unique
  type        String
  description String
  amount      Float
  currency    String     @default("USD")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  businesses  Business[]
}

model Product {
  id         String   @id @default(uuid())
  name       String
  barcode    String?
  sku        String?
  stock      Int      @default(0)
  price      Float    @default(0.0)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([barcode])
  @@index([sku])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model RestaurantTable {
  id          String      @id @default(uuid())
  tableNumber String
  capacity    String      @default("4 Persons")
  section     String      @default("Main Hall")
  status      TableStatus @default(AVAILABLE)
  subStatus   String?
  isActive    Boolean     @default(true)
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([businessId])
  @@index([status])
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String?
  category    String      @default("Main Course")
  price       Float       @default(0.0)
  prepTime    String?     @default("15 mins")
  isAvailable Boolean     @default(true)
  imageUrl    String?
  isActive    Boolean     @default(true)
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([businessId])
  @@index([category])
  @@index([isAvailable])
}

model Order {
  id          String           @id @default(uuid())
  orderNumber String
  tableNumber String?
  status      OrderStatus      @default(PENDING)
  totalBill   Float            @default(0.0)
  notes       String?
  tableId     String?
  table       RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String
  quantity   Int       @default(1)
  unitPrice  Float     @default(0.0)
  totalPrice Float     @default(0.0)
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([orderId])
}
